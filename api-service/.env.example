# ==============================================
# Noosphere API Service Environment Variables
# ==============================================
#
# Priority: Environment variables override config.yaml values
# Setup: cp .env.example .env and customize for your environment
#
# IMPORTANT: Never commit .env file to version control!
# The .env file may contain secrets (API keys, passwords)
#

# ----------------------------------------------
# Database Configuration
# ----------------------------------------------
# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
# Required for API service to function
DATABASE_URL=postgresql://noosphere_user:dev_password@localhost:5432/noosphere

# Database connection pool size (optional, defaults from config.yaml)
# Recommended: 5 for development, 20-50 for production
DB_POOL_SIZE=5

# Maximum overflow connections beyond pool size (optional)
# Recommended: 10 for development, 20-100 for production
DB_MAX_OVERFLOW=10

# ----------------------------------------------
# Vault Configuration
# ----------------------------------------------
# Path to local markdown vault
# Supports ~ (home directory) and environment variables
# Note: API service does not directly access vault in production
VAULT_PATH=~/noosphere-vault

# ----------------------------------------------
# AI API Keys (REQUIRED for classification and embeddings)
# ----------------------------------------------
# Get your API keys from:
# - Gemini (Google): https://aistudio.google.com/app/apikey
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic (Claude): https://console.anthropic.com/settings/keys
#
# At least ONE AI API key is required for classification features

# Gemini API key (recommended for cost-effective classification)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API key (optional, alternative to Gemini)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API key (optional, alternative for Claude models)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# AI model to use for classification (optional, defaults from config.yaml)
# Options: gemini-1.5-flash, gpt-4o-mini, claude-3-haiku
AI_MODEL=gemini-1.5-flash

# ----------------------------------------------
# Logging Configuration
# ----------------------------------------------
# Log level (optional, defaults from config.yaml)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Development: INFO or DEBUG
# Production: WARNING or ERROR
LOG_LEVEL=INFO

# Log format (optional, defaults from config.yaml)
# Options: text (human-readable), json (structured logs)
# Development: text
# Production: json
LOG_FORMAT=text

# ----------------------------------------------
# API Server Configuration
# ----------------------------------------------
# Host to bind to (optional, defaults from config.yaml)
# Development: 127.0.0.1 (localhost only)
# Production: 0.0.0.0 (all interfaces for Docker/K8s)
API_HOST=127.0.0.1

# Port to listen on (optional, defaults from config.yaml)
# Default: 8000
API_PORT=8000

# Debug mode - auto-reload on code changes (optional)
# Development: true
# Production: false (NEVER enable in production!)
API_DEBUG=false

# ----------------------------------------------
# Scheduler Configuration
# ----------------------------------------------
# Surfacing job interval in seconds (optional, defaults from config.yaml)
# Default: 86400 (24 hours - once per day)
# Minimum recommended: 3600 (1 hour)
SURFACING_INTERVAL_SECONDS=86400

# Batch size for processing items (optional, defaults from config.yaml)
# Development: 50
# Production: 100-500
SCHEDULER_BATCH_SIZE=50

# ==============================================
# Additional Notes
# ==============================================
#
# Environment Variable Priority:
#   1. Environment variables (this .env file)
#   2. config.yaml values
#   3. Hard-coded defaults
#
# Security Best Practices:
#   - Never commit .env file to git (it's in .gitignore)
#   - Never commit API keys to version control
#   - Use strong passwords for DATABASE_URL
#   - Rotate API keys regularly
#   - Use environment-specific .env files (dev, staging, prod)
#
# Troubleshooting:
#   - If config fails to load, check config.yaml exists
#   - If database connection fails, verify DATABASE_URL
#   - If AI features fail, verify at least one API key is set
#   - See logs/api-service.log for detailed error messages
#
